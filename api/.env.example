APP_NAME="Inspection Levage API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Indian/Antananarivo

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de données ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=inspection_levage
DB_USERNAME=inspection_user
DB_PASSWORD=change_me

# --- Sanctum / Auth API ---
SANCTUM_STATEFUL_DOMAINS=
SESSION_DRIVER=file

# --- Stockage des photos / documents / PDF ---
FILESYSTEM_DISK=local
# Passer à "s3" ou un stockage compatible (ex. Azure Blob via package tiers)
# quand le volume de photos deviendra important.

# --- Mail (envoi des rapports) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@inspection-levage.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- CORS (frontend React + mobile React Native) ---
FRONTEND_URL=http://localhost:5173
